# Copy to backend/.env and fill in. Under Docker Compose, compose reads this
# same file -- see docker-compose.yml.

# ─── Required ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# Signs the session cookie. Any long random string; changing it ends every
# active session. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Encrypts connection passwords before they go into Redis. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=your-fernet-key

# ─── Redis: the only datastore ───────────────────────────────────────────────
# Under docker compose this is set for you to redis://redis:6379/0.
# A password-protected Redis needs it in the URL: redis://:PASSWORD@host:6379/0
REDIS_URL=redis://localhost:6379/0

# How long to wait on it, and how many times to retry a command before giving
# up and answering 503. Short: Redis is next door, so slow means broken.
REDIS_CONNECT_TIMEOUT=2
REDIS_TIMEOUT=3
REDIS_RETRIES=2

# ─── Model (optional) ────────────────────────────────────────────────────────
# Any model your Groq key can reach.
GROQ_MODEL=moonshotai/kimi-k2-instruct-0905

# ─── Sessions (optional) ─────────────────────────────────────────────────────
# 24 hours, fixed from creation rather than extended on use.
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=sql_agent_session
# A frontend on a different site needs samesite=none AND secure=true, which
# requires HTTPS on both ends. Over plain-HTTP localhost, keep lax/false.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# ─── CORS (optional) ─────────────────────────────────────────────────────────
# Browser origins allowed to call the API, comma separated. Because the session
# is a cookie, these must be exact origins -- "*" is not usable with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ─── Errors (optional) ───────────────────────────────────────────────────────
# Include a `debug` block -- exception type, operator hint, upstream's own text
# -- in every error response, next to the message written for a reader.
#
# On by default: the person calling this API is the person who has to fix it.
# Set it to false before anyone else can reach the server -- exception types and
# upstream bodies are a map of the internals for whoever asks.
EXPOSE_ERROR_DETAILS=true

# ─── Agent (optional) ────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=8
AGENT_MAX_ROWS=1000
AGENT_ROW_SAMPLE=20
MAX_HISTORY_MESSAGES=20
ENGINE_CACHE_SIZE=20
# Seconds to wait on one model call, and retries for a failed one.
AGENT_LLM_TIMEOUT=60
AGENT_LLM_RETRIES=2

# ─── Connected databases (optional) ──────────────────────────────────────────
# Deadlines on databases we do not run, reached over a network we do not
# control. Without the second, one careless query holds a worker indefinitely.
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30

# ─── Logfire (optional; without a token nothing is sent, console output only) ─
LOGFIRE_ENVIRONMENT=dev
# Set to false to silence local console output.
LOGFIRE_CONSOLE=true

# ─── LangSmith tracing (optional; remove if you don't use LangSmith) ─────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=sql_agent
